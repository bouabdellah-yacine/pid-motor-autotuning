    [ "btn_load:2.l", "esp:GND.1", "black", [] ],
    [ "btn_tune:1.l", "esp:27", "gray", [] ],
    [ "btn_tune:2.l", "esp:GND.1", "black", [] ],
    [ "led_pwm:A", "esp:2", "orange", [] ],
    [ "led_pwm:C", "r1:1", "black", [] ],
